# BeaconGalaxy: STM32F405RGTx (empty "load" baseline) + this patch.
# Pins from the board schematic and the old firmware.
# App code (not CubeMX) sets up: SPI1 TX-only (OLED), TIM3 CH3 + DMA1 (WS2812
# on PB0), ADC1 IN0 + TIM2 + DMA2 (microphone), so their exact timing stays
# in one place (App/Matrix, App/Oled, App/Eq).

# --- clock: 8 MHz crystal, 168 MHz, 48 MHz for SDIO ---
ip RCC
PH0-OSC_IN.Mode=HSE-External-Oscillator
PH0-OSC_IN.Signal=RCC_OSC_IN
PH1-OSC_OUT.Mode=HSE-External-Oscillator
PH1-OSC_OUT.Signal=RCC_OSC_OUT
RCC.HSE_VALUE=8000000
RCC.PLLSourceVirtual=RCC_PLLSOURCE_HSE
RCC.PLLM=8
RCC.PLLN=336
RCC.PLLQ=7
RCC.SYSCLKSource=RCC_SYSCLKSOURCE_PLLCLK
RCC.APB1CLKDivider=RCC_HCLK_DIV4
RCC.APB2CLKDivider=RCC_HCLK_DIV2
RCC.IPParameters=HSE_VALUE,PLLSourceVirtual,PLLM,PLLN,PLLQ,SYSCLKSource,APB1CLKDivider,APB2CLKDivider

# --- debug ---
ip SYS
PA13.Mode=Serial_Wire
PA13.Signal=SYS_JTMS-SWDIO
PA14.Mode=Serial_Wire
PA14.Signal=SYS_JTCK-SWCLK
-VP_SYS_VS_Systick.
VP_SYS_VS_tim6.Mode=TIM6
VP_SYS_VS_tim6.Signal=SYS_VS_tim6

# --- console: USART1 PA9/PA10 -> FT232 (COM10) ---
ip USART1
PA9.GPIOParameters=GPIO_Label
PA9.GPIO_Label=CONSOLE_TX
PA9.Mode=Asynchronous
PA9.Signal=USART1_TX
PA10.GPIOParameters=GPIO_Label
PA10.GPIO_Label=CONSOLE_RX
PA10.Mode=Asynchronous
PA10.Signal=USART1_RX
USART1.BaudRate=115200
USART1.IPParameters=VirtualMode,BaudRate
USART1.VirtualMode=VM_ASYNC

# --- link to AudioGalaxy: USART2 PA2/PA3 (J7) ---
ip USART2
PA2.GPIOParameters=GPIO_Label
PA2.GPIO_Label=LINK_TX
PA2.Mode=Asynchronous
PA2.Signal=USART2_TX
PA3.GPIOParameters=GPIO_Label
PA3.GPIO_Label=LINK_RX
PA3.Mode=Asynchronous
PA3.Signal=USART2_RX
USART2.BaudRate=115200
USART2.IPParameters=VirtualMode,BaudRate
USART2.VirtualMode=VM_ASYNC

# --- EEPROM: I2C2 PB10 SCL / PB11 SDA (4.7k pull-ups on the board) ---
ip I2C2
PB10.Mode=I2C
PB10.Signal=I2C2_SCL
PB11.Mode=I2C
PB11.Signal=I2C2_SDA
I2C2.ClockSpeed=100000
I2C2.IPParameters=ClockSpeed

# --- microSD: SDIO 4-bit + DMA2 (stream 3 RX, stream 6 TX) ---
ip SDIO
ip DMA
PC8.Mode=SD_4_bits_Wide_bus
PC8.Signal=SDIO_D0
PC9.Mode=SD_4_bits_Wide_bus
PC9.Signal=SDIO_D1
PC10.Mode=SD_4_bits_Wide_bus
PC10.Signal=SDIO_D2
PC11.Mode=SD_4_bits_Wide_bus
PC11.Signal=SDIO_D3
PC12.Mode=SD_4_bits_Wide_bus
PC12.Signal=SDIO_CK
PD2.Mode=SD_4_bits_Wide_bus
PD2.Signal=SDIO_CMD
SDIO.IPParameters=WideMode
SDIO.WideMode=SDIO_BUS_WIDE_4B
Dma.Request0=SDIO_RX
Dma.Request1=SDIO_TX
Dma.RequestsNb=2
Dma.SDIO_RX.0.Direction=DMA_PERIPH_TO_MEMORY
Dma.SDIO_RX.0.FIFOMode=DMA_FIFOMODE_ENABLE
Dma.SDIO_RX.0.FIFOThreshold=DMA_FIFO_THRESHOLD_FULL
Dma.SDIO_RX.0.Instance=DMA2_Stream3
Dma.SDIO_RX.0.MemBurst=DMA_MBURST_INC4
Dma.SDIO_RX.0.MemDataAlignment=DMA_MDATAALIGN_WORD
Dma.SDIO_RX.0.MemInc=DMA_MINC_ENABLE
Dma.SDIO_RX.0.Mode=DMA_PFCTRL
Dma.SDIO_RX.0.PeriphBurst=DMA_PBURST_INC4
Dma.SDIO_RX.0.PeriphDataAlignment=DMA_PDATAALIGN_WORD
Dma.SDIO_RX.0.PeriphInc=DMA_PINC_DISABLE
Dma.SDIO_RX.0.Priority=DMA_PRIORITY_HIGH
Dma.SDIO_RX.0.RequestParameters=Instance,Direction,PeriphInc,MemInc,PeriphDataAlignment,MemDataAlignment,Mode,Priority,FIFOMode,FIFOThreshold,MemBurst,PeriphBurst
Dma.SDIO_TX.1.Direction=DMA_MEMORY_TO_PERIPH
Dma.SDIO_TX.1.FIFOMode=DMA_FIFOMODE_ENABLE
Dma.SDIO_TX.1.FIFOThreshold=DMA_FIFO_THRESHOLD_FULL
Dma.SDIO_TX.1.Instance=DMA2_Stream6
Dma.SDIO_TX.1.MemBurst=DMA_MBURST_INC4
Dma.SDIO_TX.1.MemDataAlignment=DMA_MDATAALIGN_WORD
Dma.SDIO_TX.1.MemInc=DMA_MINC_ENABLE
Dma.SDIO_TX.1.Mode=DMA_PFCTRL
Dma.SDIO_TX.1.PeriphBurst=DMA_PBURST_INC4
Dma.SDIO_TX.1.PeriphDataAlignment=DMA_PDATAALIGN_WORD
Dma.SDIO_TX.1.PeriphInc=DMA_PINC_DISABLE
Dma.SDIO_TX.1.Priority=DMA_PRIORITY_HIGH
Dma.SDIO_TX.1.RequestParameters=Instance,Direction,PeriphInc,MemInc,PeriphDataAlignment,MemDataAlignment,Mode,Priority,FIFOMode,FIFOThreshold,MemBurst,PeriphBurst

# --- FatFs on the SD card, long file names, thread safe ---
ip FATFS
VP_FATFS_VS_SDIO.Mode=SDIO
VP_FATFS_VS_SDIO.Signal=FATFS_VS_SDIO
FATFS.IPParameters=_USE_LFN,_MAX_LFN,_USE_FIND,_CODE_PAGE,_FS_REENTRANT,_USE_STRFUNC,USE_DMA_CODE_SD
FATFS._USE_LFN=2
FATFS._MAX_LFN=255
FATFS._USE_FIND=1
FATFS._CODE_PAGE=437
FATFS._FS_REENTRANT=1
FATFS._USE_STRFUNC=2
FATFS.USE_DMA_CODE_SD=1

# --- OLED control pins (SPI1 itself is set up in App/Oled) ---
PA4.GPIOParameters=GPIO_Label,PinState,GPIO_Speed
PA4.GPIO_Label=OLED_CS
PA4.PinState=GPIO_PIN_SET
PA4.GPIO_Speed=GPIO_SPEED_FREQ_HIGH
PA4.Signal=GPIO_Output
PB15.GPIOParameters=GPIO_Label,GPIO_Speed
PB15.GPIO_Label=OLED_DC
PB15.GPIO_Speed=GPIO_SPEED_FREQ_HIGH
PB15.Signal=GPIO_Output
PB14.GPIOParameters=GPIO_Label,PinState
PB14.GPIO_Label=OLED_RST
PB14.PinState=GPIO_PIN_SET
PB14.Signal=GPIO_Output

# --- buttons (10k pull-downs on the board, active HIGH: pressed = 3.3 V) ---
PC0.GPIOParameters=GPIO_Label,GPIO_PuPd
PC0.GPIO_Label=BTN_UP
PC0.GPIO_PuPd=GPIO_PULLDOWN
PC0.Signal=GPIO_Input
PC1.GPIOParameters=GPIO_Label,GPIO_PuPd
PC1.GPIO_Label=BTN_DOWN
PC1.GPIO_PuPd=GPIO_PULLDOWN
PC1.Signal=GPIO_Input
PC2.GPIOParameters=GPIO_Label,GPIO_PuPd
PC2.GPIO_Label=BTN_BACK
PC2.GPIO_PuPd=GPIO_PULLDOWN
PC2.Signal=GPIO_Input
PC7.GPIOParameters=GPIO_Label,GPIO_PuPd
PC7.GPIO_Label=BTN_ENTER
PC7.GPIO_PuPd=GPIO_PULLDOWN
PC7.Signal=GPIO_Input

# --- status LEDs ---
PB6.GPIOParameters=GPIO_Label
PB6.GPIO_Label=LED_GREEN
PB6.Signal=GPIO_Output
PB7.GPIOParameters=GPIO_Label
PB7.GPIO_Label=LED_ORANGE
PB7.Signal=GPIO_Output
PB8.GPIOParameters=GPIO_Label
PB8.GPIO_Label=LED_RED
PB8.Signal=GPIO_Output
PB9.GPIOParameters=GPIO_Label
PB9.GPIO_Label=LED_BLUE
PB9.Signal=GPIO_Output

# --- RNG, CRC (TouchGFX) ---
ip RNG
VP_RNG_VS_RNG.Mode=RNG_Activate
VP_RNG_VS_RNG.Signal=RNG_VS_RNG
ip CRC
VP_CRC_VS_CRC.Mode=CRC_Activate
VP_CRC_VS_CRC.Signal=CRC_VS_CRC

# --- FreeRTOS (CMSIS-RTOS2) ---
ip FREERTOS
VP_FREERTOS_VS_CMSIS_V2.Mode=CMSIS_V2
VP_FREERTOS_VS_CMSIS_V2.Signal=FREERTOS_VS_CMSIS_V2
FREERTOS.IPParameters=Tasks01,configUSE_NEWLIB_REENTRANT,configTOTAL_HEAP_SIZE,configCHECK_FOR_STACK_OVERFLOW,configUSE_MALLOC_FAILED_HOOK,configRECORD_STACK_HIGH_ADDRESS
FREERTOS.Tasks01=defaultTask,24,1024,StartDefaultTask,Default,NULL,Dynamic,NULL,NULL
FREERTOS.configTOTAL_HEAP_SIZE=60000
FREERTOS.configUSE_NEWLIB_REENTRANT=1
FREERTOS.configCHECK_FOR_STACK_OVERFLOW=2
FREERTOS.configUSE_MALLOC_FAILED_HOOK=1
FREERTOS.configRECORD_STACK_HIGH_ADDRESS=1

# --- NVIC: group 4; everything that calls the RTOS at >= 5 ---
ip NVIC
NVIC.PriorityGroup=NVIC_PRIORITYGROUP_4
NVIC.ForceEnableDMAVector=true
NVIC.SysTick_IRQn=true\:15\:0\:false\:false\:false\:true\:false\:true\:false
NVIC.PendSV_IRQn=true\:15\:0\:false\:false\:false\:true\:false\:false\:false
NVIC.SVCall_IRQn=true\:0\:0\:false\:false\:false\:false\:false\:false\:false
NVIC.SavedPendsvIrqHandlerGenerated=true
NVIC.SavedSvcallIrqHandlerGenerated=true
NVIC.SavedSystickIrqHandlerGenerated=true
NVIC.TIM6_DAC_IRQn=true\:15\:0\:false\:false\:true\:false\:false\:true\:true
NVIC.TimeBase=TIM6_DAC_IRQn
NVIC.TimeBaseIP=TIM6
NVIC.USART1_IRQn=true\:7\:0\:false\:false\:true\:true\:true\:true\:true
NVIC.USART2_IRQn=true\:5\:0\:false\:false\:true\:true\:true\:true\:true
NVIC.SDIO_IRQn=true\:6\:0\:false\:false\:true\:true\:true\:true\:true
NVIC.DMA2_Stream3_IRQn=true\:6\:0\:false\:false\:true\:true\:false\:true\:true
NVIC.DMA2_Stream6_IRQn=true\:6\:0\:false\:false\:true\:true\:false\:true\:true

# --- project ---
ProjectManager.ProjectName=BeaconGalaxy
ProjectManager.ProjectFileName=BeaconGalaxy.ioc
ProjectManager.TargetToolchain=CMake
ProjectManager.FirmwarePackage=STM32Cube FW_F4 V1.28.3
ProjectManager.KeepUserCode=true
ProjectManager.CoupleFile=true
ProjectManager.LibraryCopy=0
ProjectManager.MainLocation=Core/Src
ProjectManager.StackSize=0x800
ProjectManager.HeapSize=0x400
ProjectManager.UnderRoot=false
ProjectManager.BackupPrevious=false
ProjectManager.DeletePrevious=true

# --- FatFs "card detect": the connector's CD pin is not wired (schematic), so
# PC13 (unconnected) is used with a pull-down: it always reads "card present".
# Without a pin CubeMX stops code generation with a FATFS platform warning.
PC13-ANTI_TAMP.GPIOParameters=GPIO_Label,GPIO_PuPd
PC13-ANTI_TAMP.GPIO_Label=SD_DETECT_NC
PC13-ANTI_TAMP.GPIO_PuPd=GPIO_PULLDOWN
PC13-ANTI_TAMP.Signal=GPIO_Input
FATFS.BSP.number=1
FATFS0.BSP.STBoard=false
FATFS0.BSP.api=Unknown
FATFS0.BSP.component=
FATFS0.BSP.condition=
FATFS0.BSP.i2caddr=0
FATFS0.BSP.i2creg=0
FATFS0.BSP.instance=PC13-ANTI_TAMP
FATFS0.BSP.ip=GPIO
FATFS0.BSP.mode=Input
FATFS0.BSP.name=Detect_SDIO
FATFS0.BSP.semaphore=
FATFS0.BSP.solution=PC13-ANTI_TAMP
